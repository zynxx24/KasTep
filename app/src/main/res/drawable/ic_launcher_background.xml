<?xml version="1.0" encoding="utf-8"?>
<!-- » Deklarasi XML (pengaturan, bukan kode). -->
<!-- » <vector> = gambar vektor (dibuat dari garis dan bentuk, tetap tajam di ukuran apa pun). -->
<!-- » android:width : width = lebar gambar 108dp. -->
<!-- » android:height : height = tinggi gambar 108dp. -->
<!-- » android:viewportWidth : viewportWidth = lebar ruang gambar internal 108 satuan. -->
<!-- » android:viewportHeight : viewportHeight = tinggi ruang gambar internal 108 satuan. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- » <path> = satu bentuk yang digambar. -->
    <!-- » android:fillColor : fillColor #000000 = isi bentuk berwarna hitam. -->
    <!-- » android:pathData : pathData M0,0h108v108h-108z = bentuk persegi yang menutupi seluruh kanvas (latar -->
    <!-- » hitam). -->
    <path
        android:fillColor="#000000"
        android:pathData="M0,0h108v108h-108z" />
</vector>
